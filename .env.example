# ตัวแปร environment ของระบบตารางเรียน (production) — ตั้งที่ Vercel → Project → Settings → Environment Variables
# ไฟล์นี้เป็นแม่แบบ ไม่มีค่าจริง · ห้าม commit ไฟล์ที่มีค่าจริง · ขั้นตอนทีละข้อดู docs/DEPLOY.md
#
# ห้ามตั้งความลับด้วยชื่อที่ขึ้นต้น VITE_ (ถูกฝังลงหน้าเว็บที่ทุกคนอ่านได้ — vite.config.js ทำให้ build ล้มเพื่อกันพลาด)
# แยกค่า Production กับ Preview: คนละฐานข้อมูล Upstash, คนละ SESSION_SECRET, คนละบัญชีแอดมิน
# อย่าเขียนคำอธิบายต่อท้ายบรรทัดค่า (VAR=ค่า คำอธิบาย) — คำอธิบายจะกลายเป็นส่วนของค่า ให้เขียนบรรทัดแยกที่ขึ้นต้นด้วย #

# ---------- ฐานข้อมูล Upstash Redis (บังคับ) ----------
# Upstash console → Database → แท็บ "REST API" (ไม่ใช่ที่อยู่ redis://)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# (ไม่บังคับ แนะนำ) token แบบอ่านอย่างเดียวของฐานเดียวกัน — เส้นทางผู้ชม/ลิงก์แชร์ใช้อ่านข้อมูล จึงเขียนไม่ได้แม้โค้ดผิดพลาด
# UPSTASH_REDIS_REST_READONLY_TOKEN=

# ---------- ความลับของเซิร์ฟเวอร์ (บังคับ) ----------
# กุญแจ HMAC ของเซสชัน ยาวอย่างน้อย 32 ไบต์ สุ่ม · เปลี่ยนค่า = ทุกคนต้องเข้าสู่ระบบใหม่ทันที
# สร้างด้วย:  node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# บัญชีแอดมิน รูปแบบ  username:scrypt$32768$8$1$<salt>$<hash>  หลายบัญชีคั่นด้วย ;
# สร้างด้วย:  npm run hash-password -- <username>  (พิมพ์รหัสผ่านตอนถาม ไม่ส่งผ่าน argument) แล้ววางผลทั้งบรรทัดที่ช่อง Value ของ Vercel
# ใน Vercel วางตรง ๆ ไม่ต้องใส่คำพูด · ถ้าจำเป็นต้องอยู่ในไฟล์ .env ต้อง escape $ เป็น \$ (ดู docs/DEPLOY.md)
ADMIN_ACCOUNTS=

# origin ที่อนุญาตให้ส่งคำขอเขียน/login (คั่นด้วย ,) เทียบ scheme+host+port เต็ม ไม่มี / ท้าย
# เช่น https://timetable.example.com · ไม่ตั้งบน Vercel (preview/production) = เขียนไม่ได้ (500)
ALLOWED_ORIGINS=

# ---------- ปรับแต่ง (ไม่บังคับ) ----------
# เพดานคำขอ GET /api/public ต่อ IP ต่อนาที — ไม่ตั้ง = 300 (โรงเรียนอยู่หลัง NAT เดียว) · ค่า 10–100000
# PUBLIC_RATE_LIMIT=300
